# Copy to .env.local. Never commit real secrets.
DATABASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Fixed production URL, or http://localhost:3000 during local development.
AUTH_URL=http://localhost:3000
# Comma-separated exact school email addresses. No automatic first-user admin.
ADMIN_EMAILS=
